datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Theme {
  id         Int     @id @default(1)
  background String  @default("#E6EFE9")
  heading    String  @default("#1F3D2B")
  accent     String  @default("#C8A96A")
  softAccent String  @default("#d8cbb5")
  card       String  @default("#F8F5EF")
  cardBorder String  @default("#e6dcc9")
  showImages Boolean @default(true)
}

model RestaurantInfo {
  id      Int    @id @default(1)
  name    String
  tagline String
  phone   String
  email   String
  address String
}

model Section {
  id    String  @id
  title String
  image String?
  fit   String?
  page  String // "page1" or "page2"
  col   Int     @default(0) // manual column index 0-4 (drag & drop placement)
  order Int // position within the column
  items Item[]
}

model Item {
  id          String  @id
  name        String
  description String?
  price       String
  order       Int
  sectionId   String
  section     Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}
